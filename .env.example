# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadgen
DB_USER=postgres
DB_PASS=postgres

# Scraper
SCRAPE_DELAY=0.5
SCRAPE_TIMEOUT=15
SCRAPE_MAX_RETRIES=3
MAX_WORKERS=5
BATCH_SIZE=100
RUN_INTERVAL_HOURS=6

# Google Sheets (warehouse)
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDS_FILE=credentials/gsheets_key.json
GOOGLE_SHEET_NAME=Leads